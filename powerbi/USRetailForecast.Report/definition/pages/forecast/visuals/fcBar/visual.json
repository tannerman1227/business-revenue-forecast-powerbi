{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "fcBar",
  "position": {
    "x": 16,
    "y": 444,
    "z": 5,
    "height": 260,
    "width": 1248,
    "tabOrder": 5
  },
  "visual": {
    "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualConfiguration/2.2.0/schema.json",
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimSector"
                    }
                  },
                  "Property": "SectorShort"
                }
              },
              "queryRef": "DimSector.SectorShort",
              "nativeQueryRef": "SectorShort"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metrics"
                    }
                  },
                  "Property": "Forward 12 Forecast"
                }
              },
              "queryRef": "Metrics.Forward 12 Forecast",
              "nativeQueryRef": "Forward 12 Forecast"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Metrics"
                  }
                },
                "Property": "Forward 12 Forecast"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": false
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Next 12 months by sector'"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#0B1F33'"
                    }
                  }
                }
              }
            },
            "bold": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    }
  }
}
