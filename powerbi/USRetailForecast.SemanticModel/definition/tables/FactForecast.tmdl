			        {"Date", type date},
			        {"SectorKey", type text},
			        {"Horizon", Int64.Type},
			        {"ForecastNSA", type number},
			        {"Lower80", type number},
			        {"Upper80", type number},
			        {"ReconcileFactor", type number},
			        {"Model", type text}
			    }
			)

	annotation PBI_ResultType = Table

