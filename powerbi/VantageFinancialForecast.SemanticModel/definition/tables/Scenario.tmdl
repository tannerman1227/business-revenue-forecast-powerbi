/// Budget, the FY2025 backtest, and the three FY2026 forecast scenarios.
table Scenario
	lineageTag: 01fe33d3-a2f3-50bb-84e6-cc285b1a5700

	column Scenario
		dataType: string
		isKey
		lineageTag: d78c5e7b-ef33-5233-8376-e99f926b1a97
		summarizeBy: none
		sourceColumn: Scenario
		sortByColumn: SortOrder
		annotation SummarizationSetBy = Automatic

	column ScenarioGroup
		dataType: string
		lineageTag: 44db4a53-e030-5266-a19c-0e761a63f364
		summarizeBy: none
		sourceColumn: ScenarioGroup
		annotation SummarizationSetBy = Automatic

	column SortOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 87490c06-5794-590b-997a-7a2a92fede03
		summarizeBy: none
		sourceColumn: SortOrder
		annotation SummarizationSetBy = Automatic

	partition Scenario = m
		mode: import
		source =
			let
			    Source = Table.FromRows(
			        {
			            {"Budget", "Plan", 1},
			            {"Backtest", "Model Validation", 2},
			            {"Forecast - Downside", "Rolling Forecast", 3},
			            {"Forecast - Base", "Rolling Forecast", 4},
			            {"Forecast - Upside", "Rolling Forecast", 5}
			        },
			        {"Scenario", "ScenarioGroup", "SortOrder"}
			    ),
			    Typed = Table.TransformColumnTypes(Source, {{"Scenario", type text}, {"ScenarioGroup", type text}, {"SortOrder", Int64.Type}})
			in
			    Typed


	annotation PBI_ResultType = Table
