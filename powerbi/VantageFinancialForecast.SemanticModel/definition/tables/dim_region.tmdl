/// Region, region code, and management group. Four regions, reported in USD.
table dim_region
	lineageTag: 529c09b7-fd26-5d71-bbab-3e8f96d9edb5

	column RegionKey
		dataType: int64
		isKey
		isHidden
		formatString: 0
		lineageTag: 7ef323e0-48bc-51c4-8b67-cc23cd1a642c
		summarizeBy: none
		sourceColumn: RegionKey
		annotation SummarizationSetBy = Automatic
	column Region
		dataType: string
		lineageTag: 1ece9477-567d-5d9a-8687-e15652493e54
		summarizeBy: none
		sourceColumn: Region
		annotation SummarizationSetBy = Automatic
	column RegionCode
		dataType: string
		lineageTag: 80dd1524-9f3e-5b52-b917-1796a334b329
		summarizeBy: none
		sourceColumn: RegionCode
		annotation SummarizationSetBy = Automatic
	column ManagementGroup
		dataType: string
		lineageTag: a667ce51-86b3-5a11-bd8a-71b4f8c10d00
